{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "space": {
    "$type": "dimension",
    "control": {
      "inline": {
        "$value": "{primitive.space.3}"
      },
      "block": {
        "$value": "{primitive.space.2}"
      }
    },
    "component": {
      "gap": {
        "$value": "{primitive.space.2}"
      },
      "section": {
        "$value": "{primitive.space.4}"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": {
        "$value": "{primitive.size.8}"
      },
      "md": {
        "$value": "{primitive.size.9}"
      },
      "lg": {
        "$value": "{primitive.size.10}"
      }
    },
    "icon": {
      "sm": {
        "$value": "{primitive.size.iconSm}"
      },
      "md": {
        "$value": "{primitive.size.iconMd}"
      },
      "lg": {
        "$value": "{primitive.size.iconLg}"
      }
    }
  }
}
